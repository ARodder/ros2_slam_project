#
# Created using OpenAI Codex.
# Not Reviewed and not verified by Magnus Mortensen.
# RViz profile for offboard navigation visualization.
#

Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic:
        Value: /map
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Pose
      Topic:
        Value: /pose
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Planned Path
      Topic:
        Value: /planned_path
  Global Options:
    Fixed Frame: map
  Name: root
Window Geometry:
  Height: 800
  Width: 1200
